# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ---------- General ----------
ENVIRONMENT=development
PROJECT_NAME="Nellai Green & Civic"
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Database ----------
POSTGRES_USER=nellai
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=nellai_green_civic
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nellai:change_me_dev_password@db:5432/nellai_green_civic

# ---------- Auth / JWT ----------
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- File storage ----------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
MAX_UPLOAD_SIZE_MB=8
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# S3-compatible storage (optional, used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# ---------- AI classification service ----------
AI_SERVICE_URL=http://ai-service:8100
AI_SERVICE_ENABLED=true
AI_SERVICE_TIMEOUT_SECONDS=15

# ---------- Notifications ----------
NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nellaigreencivic.org
FCM_SERVER_KEY=

# ---------- Redis (rate limiting / caching / celery) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE=60

# ---------- Escalation engine ----------
DEFAULT_WORKING_DAYS_DEADLINE=3
DEFAULT_TIMEZONE=Asia/Kolkata

# ---------- Web app ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------- Mobile app (build-time, not committed per-flavor) ----------
MOBILE_API_BASE_URL_DEV=http://10.0.2.2:8000/api/v1
MOBILE_API_BASE_URL_PROD=https://api.nellaigreencivic.org/api/v1
